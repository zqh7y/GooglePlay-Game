{
  "name": "dice-survivor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check-secrets": "node dev/check-secrets.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "check-bundle": "node dev/check-bundle.mjs",
    "emulators": "firebase emulators:start --project demo-dice-idle",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dice-idle \"node --test dev/online/rules.test.mjs\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/firestore": "^8.5.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource/jua": "^5.2.5",
    "firebase": "^12.19.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.34.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
